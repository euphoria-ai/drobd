# Copy to app/.env. EXPO_PUBLIC_ vars are inlined into the JS bundle at build
# time, so only ever put publishable values here -- never a service role key.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon or sb_publishable_ key>

# The FastAPI service. In development this must be the machine's LAN address,
# not localhost -- localhost on a phone means the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
