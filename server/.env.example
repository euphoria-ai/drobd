# Copy to .env and fill in. Never commit .env.

# Required for naming/categorising and outfit suggestions. Without it the
# service still returns cutouts, just with placeholder labels.
GROQ_API_KEY=

# Verified against console.groq.com/docs/vision (Aug 2026). qwen3.6-27b is
# currently the only Groq model that accepts image input.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# birefnet-general has the tightest edges. birefnet-general-lite is ~3x faster
# with visibly softer alpha -- worth it only on constrained hardware.
REMBG_MODEL=birefnet-general
REMBG_ALPHA_MATTING=false

MAX_UPLOAD_MB=12
SEGMENT_MAX_EDGE=1600
CUTOUT_MAX_EDGE=1024
LABEL_MAX_EDGE=768
